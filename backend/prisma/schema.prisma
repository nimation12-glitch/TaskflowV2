// TaskFlow — AI API Gateway & Infrastructure Platform
// Database schema (SQLite via Prisma)
//
// MONEY CONVENTION (critical):
//   All stored monetary amounts are integers in MICRO-GBP (1_000_000 micros = £1.00).
//   Field suffix: *Micros. Rates (per 1K tokens / per GPU-hour) are Float micros.
//   Rationale: per-request AI charges are often < £0.01; micro precision prevents
//   rounding away real usage while keeping money out of floating point aggregates.
//
// STATUS STRING CONVENTION:
//   SQLite + Prisma: enums modelled as constrained strings, validated in
//   application layer (zod schemas in src/server/validation.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// Identity & sessions
// ─────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid()) // non-sequential, opaque public identifier (Phase 1 §2)
  email           String    @unique // normalized lowercase — verified-email uniqueness (correction spec §4)
  emailVerifiedAt DateTime? // set by the verification flow or a verified OAuth identity claim
  name            String?
  avatarUrl       String?
  // E.164-normalized phone (anti-abuse, correction spec §3). Uniqueness of
  // VERIFIED phones is enforced transactionally at confirmation time
  // (SQLite has no partial unique index via db push).
  phone           String?
  phoneVerifiedAt DateTime?
  // Account lifecycle: PENDING = registered but the verification policy
  // (email + phone for email/password accounts) is not yet satisfied — the
  // dashboard/org endpoints refuse access. ACTIVE = fully usable. SUSPENDED
  // = locked out everywhere. OAuth accounts with a provider-verified email
  // are activated on first sign-in; email/password accounts activate after
  // BOTH verifications (correction spec §2, §17).
  status          String    @default("PENDING")
  lastLoginAt     DateTime?
  role            String    @default("CUSTOMER") // CUSTOMER | ADMIN (platform-level, NOT org roles)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions           Session[]
  passwordCredential PasswordCredential?
  identities         AuthenticationIdentity[]
  authTokens         AuthToken[]
  phoneChallenges    PhoneVerificationChallenge[]
  memberships        Membership[]
  apiKeys            ApiKey[]
  usageEvents        UsageEvent[]
  invoices           Invoice[]
  gpuInstances       GpuInstance[]
  deployments        Deployment[]
  ownedOrganizations Organization[]
  // Multi-org era: subscriptions/credit accounts are org-owned; these are
  // back-relations only (the active org's rows are resolved via membership).
  subscriptions   Subscription[]
  creditAccounts  CreditAccount[]
}

// Password credentials are separate from User (Phase 1 §16): OAuth-only users
// have no password row. Format: scrypt$<saltHex>$<hashHex> (see password.ts).
model PasswordCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One external login identity (Google / Microsoft / GitHub) per row.
// Provider-specific identifiers only — OAuth access/refresh tokens are
// intentionally NOT persisted (Phase 1 §6: no provider tokens unless a
// future feature needs them).
model AuthenticationIdentity {
  id                String   @id @default(cuid())
  userId            String
  provider          String // GOOGLE | MICROSOFT | GITHUB
  providerAccountId String // stable id at the provider
  providerEmail     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Phone verification challenges (correction spec §3). The 6-digit code is
// stored ONLY as an HMAC-SHA256 (keyed by AUTH_SECRET) — raw codes never hit
// the database. Short-lived (10 min), single-use (consumedAt), attempt-
// limited (max 5 code submissions). Phone numbers stored in E.164.
model PhoneVerificationChallenge {
  id         String    @id @default(cuid())
  userId     String
  phone      String // E.164 target of THIS challenge
  codeHash   String    @unique
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// SMS outbox / send audit (correction spec §13). Mirrors EmailMessage.
// Dev/test transport stores the message body (codes readable ONLY via the
// non-production outbox route); the production transport stores a code-free
// body so verification codes never persist.
model SmsMessage {
  id        String    @id @default(cuid())
  to        String // E.164 or masked depending on transport — see sms/index.ts
  body      String
  provider  String    @default("dev") // dev | twilio | test
  status    String    @default("QUEUED") // QUEUED | SENT | FAILED
  error     String?
  createdAt DateTime  @default(now())

  @@index([to, createdAt])
}

// Single-use, expiring, hashed tokens: EMAIL_VERIFY | PASSWORD_RESET.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  tokenHash String    @unique // sha256 of the raw token; raw value only ever lives in the emailed link
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ─────────────────────────────────────────────────────────
// Organizations — the primary BILLING entity (spec §3):
//   User → Organization → Stripe Customer → Stripe Subscription
// Individual users are never the billing anchor. Until the full
// tenancy phase (memberships/invitations), every user owns one
// personal organization auto-created at signup/backfill.
// ─────────────────────────────────────────────────────────

model Organization {
  id               String   @id @default(cuid()) // non-sequential, opaque public identifier (Phase 1 §2)
  name             String
  slug             String   @unique
  // Denormalized billing convenience (Stripe flows). Authorization ALWAYS
  // goes through Membership; kept consistent transactionally on creation.
  ownerUserId      String
  status           String   @default("ACTIVE") // ACTIVE | SUSPENDED
  // Stripe customer for THIS organization (billing anchor).
  stripeCustomerId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner         User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  memberships   Membership[]
  invitations   Invitation[]
  subscription  Subscription?
  creditAccount CreditAccount?
  invoices      Invoice[]
  apiKeys       ApiKey[]

  @@index([ownerUserId])
}

// ─────────────────────────────────────────────────────────
// Multi-tenancy — memberships, invitations, audit (Phase 1)
// ─────────────────────────────────────────────────────────

// A user's access to an organization, with a single role.
// Roles: OWNER | ADMIN | MEMBER (authorization matrix in server/tenancy/authz.ts).
model Membership {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String
  role            String   @default("MEMBER") // OWNER | ADMIN | MEMBER
  invitedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// Organization invitations. The high-entropy raw token lives only in the
// emailed link; tokenHash is stored. Acceptance validates: token, expiry,
// organization state, seat availability, e-mail match (Phase 1 §19–21).
model Invitation {
  id              String    @id @default(cuid())
  organizationId  String
  invitedEmail    String
  invitedByUserId String
  role            String    @default("MEMBER") // ADMIN | MEMBER (OWNER is never granted by invitation)
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([invitedEmail])
}

// Privileged-action audit trail (Phase 1 §41). Never stores secrets —
// only ids, event types and non-sensitive metadata.
model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  action         String // signup | login | logout | oauth_connect | oauth_unlink | password_reset_requested | password_reset_completed | email_verified | invitation_created | invitation_accepted | invitation_revoked | member_removed | role_changed | organization_created | org_switched
  metadata       String? // JSON (non-sensitive context)
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([action])
}

// Transactional email record — doubles as the dev-transport outbox and a
// production send audit. Bodies only, never credentials.
model EmailMessage {
  id        String    @id @default(cuid())
  to        String
  subject   String
  body      String
  transport String    @default("dev-console") // dev-console | resend
  status    String    @default("QUEUED") // QUEUED | SENT | FAILED
  error     String?
  createdAt DateTime  @default(now())

  @@index([to, createdAt])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique // sha256 of raw session token; raw token only in cookie
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime? // set on logout / password reset / explicit revocation — revoked sessions never authenticate
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────
// Plans & subscriptions
// ─────────────────────────────────────────────────────────

model Plan {
  id                  String  @id // slug: free | pro | max
  name                String
  description         String
  monthlyPriceMicros  Int     @default(0)
  monthlyCreditMicros Int     @default(0) // monthly AI usage allowance (grant, not unlimited)
  rateLimitPerMinute  Int     @default(20)
  priority            Int     @default(0) // shared compute priority (higher = better)
  maxConcurrency      Int     @default(2)
  // DB-backed seat limit (Phase 1 §20): max ACTIVE memberships + PENDING
  // invitations. Server-enforced; never hardcoded in the application.
  maxMembers          Int     @default(3)
  canRentGpu          Boolean @default(false)
  canBuyCredits       Boolean @default(true)
  stripePriceId       String?
  isActive            Boolean @default(true)
  sortOrder           Int     @default(0)

  subscriptions     Subscription[]
  modelEntitlements ModelEntitlement[]
}

model Subscription {
  id                     String   @id @default(cuid())
  // Billing ownership lives on the organization; userId is attribution of the
  // acting/creating member (NOT unique — members share the org subscription).
  organizationId         String   @unique
  userId                 String
  planId                 String
  // ACTIVE | TRIALING | PAST_DUE | PAYMENT_FAILED | CANCELED | INCOMPLETE
  status                 String   @default("ACTIVE")
  currentPeriodStart     DateTime @default(now())
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean  @default(false)
  pastDueAt              DateTime? // start of the PAST_DUE grace window
  stripeCustomerId       String?
  stripeSubscriptionId   String?  @unique
  stripePriceId          String?
  stripeCheckoutSessionId String? @unique // fulfillment dedupe per checkout session
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([status])
  @@index([stripeCustomerId])
}

// ─────────────────────────────────────────────────────────
// API keys (raw keys never stored — hash only, peppered)
// ─────────────────────────────────────────────────────────

model ApiKey {
  id             String    @id @default(cuid())
  // ORGANIZATION-owned (Phase 1 §27). userId is the creating member
  // (attribution only). Requests resolve key → organization → entitlement.
  organizationId String?
  userId         String
  name           String
  prefix         String // display-safe prefix, e.g. "tf_live_ab12cd34"
  keyHash        String    @unique // sha256(pepper + rawKey)
  status         String    @default("ACTIVE") // ACTIVE | REVOKED
  permissions    String? // JSON array of scopes (optional; reserved)
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  usageEvents UsageEvent[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────
// Model catalog, entitlements & pricing engine
// ─────────────────────────────────────────────────────────

model AiModel {
  id            String  @id // slug: taskflow-mini, kimi-k3, ...
  displayName   String
  provider      String // taskflow | openai | moonshot | openrouter | nvidia | ...
  description   String
  capabilities  String  @default("[]") // JSON array: chat | reasoning | vision | ...
  contextWindow Int     @default(8192)
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)

  // Registry honesty fields (MASTER_PROJECT_CONTEXT §4–7).
  // status:        operator-declared lifecycle. The EFFECTIVE status shown to
  //                customers combines this with runtime provider configuration:
  //                declared LIVE + unconfigured provider ⇒ NOT_CONFIGURED.
  // hostingMode:   EXTERNAL_API | TASKFLOW_HOSTED | CUSTOMER_HOSTED (§4)
  status         String  @default("COMING_SOON") // LIVE | COMING_SOON | DISABLED | NOT_CONFIGURED | DEMO_ONLY
  hostingMode    String  @default("EXTERNAL_API") // EXTERNAL_API | TASKFLOW_HOSTED | CUSTOMER_HOSTED
  version        String? // upstream model version
  license        String? // license / terms summary — reviewed before commercial hosting claims (§5)
  sourceUrl      String? // model source / provider reference

  entitlements ModelEntitlement[]
  pricing      ModelPricing?
  usageEvents  UsageEvent[]

  @@index([provider])
}

// Which plan can use which model (tier-dependent access)
model ModelEntitlement {
  id      String @id @default(cuid())
  modelId String
  planId  String

  model AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  plan  Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([modelId, planId])
  @@index([planId])
}

// Flexible rate card — pricing lives here, NEVER hardcoded in handlers.
// customerCharge = (inputCost + outputCost + computeCost) * (1 + marginPercent/100)
model ModelPricing {
  id                     String  @id @default(cuid())
  modelId                String  @unique
  inputCostPer1kMicros   Float   @default(0) // provider cost basis, micros per 1K input tokens
  outputCostPer1kMicros  Float   @default(0) // provider cost basis, micros per 1K output tokens
  computePerSecondMicros Float   @default(0) // reserved for GPU/compute metering
  marginPercent          Float   @default(20) // TaskFlow platform margin
  currency               String  @default("GBP")
  isActive               Boolean @default(true)

  model AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────
// Usage events & credit ledger
// ─────────────────────────────────────────────────────────

model UsageEvent {
  id                  String   @id @default(cuid())
  requestId           String // gateway request id (tf-req-...)
  organizationId      String? // tenant anchor (backfilled from the key's org; Phase 1 §24)
  userId              String // attribution: which member's key generated usage
  apiKeyId            String?
  modelId             String
  provider            String
  inputTokens         Int      @default(0)
  outputTokens        Int      @default(0)
  totalTokens         Int      @default(0)
  computeSeconds      Float    @default(0) // GPU time tracked independently of tokens
  providerCostMicros  Float    @default(0)
  computeCostMicros   Float    @default(0)
  marginMicros        Float    @default(0)
  customerChargeMicros Float   @default(0)
  status              String   @default("SUCCESS") // SUCCESS | FAILED
  errorMessage        String?
  latencyMs           Int      @default(0)
  metadata            String? // JSON (deployment, gpu, request params, tier, ...)
  createdAt           DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  model  AiModel @relation(fields: [modelId], references: [id])

  @@index([userId, createdAt])
  @@index([apiKeyId])
  @@index([modelId])
  @@index([status])
}

model CreditAccount {
  id                      String   @id @default(cuid())
  organizationId          String?  @unique // billing owner (always set for new accounts)
  userId                  String   // attribution (creator/acting member; NOT unique — members share the org account)
  balanceMicros           Int      @default(0) // transactional aggregate backed by ledger
  autoTopUpEnabled        Boolean  @default(false)
  autoTopUpThresholdMicros Int?
  autoTopUpAmountMicros   Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@index([userId])
}

// Append-only financial ledger. Balance is derived from / reconciled with these rows.
model CreditTransaction {
  id                String   @id @default(cuid())
  accountId         String
  organizationId    String? // denormalized billing-owner anchor for reconciliation
  userId            String // attribution
  type              String // MONTHLY_GRANT | USAGE | PURCHASE | REFUND | ADJUSTMENT | GPU_RENTAL
  amountMicros      Int // signed: + credit added, - credit consumed
  balanceAfterMicros Int // snapshot after this transaction (audit/reconciliation)
  description       String
  referenceId       String? // usageEventId | stripe payment intent | invoice number ...
  // Idempotency key for grants derived from Stripe sources, e.g.
  //   stripe_sub_{subscriptionId}_{periodStart}
  //   stripe_cs_{checkoutSessionId}
  // A UNIQUE constraint makes double grants from webhook retries or the
  // lazy rollover physically impossible.
  uniqueGrantKey    String?  @unique
  metadata          String? // JSON: stripe_payment_intent_id, stripe_checkout_session_id, stripe_event_id, organization_id
  createdAt         DateTime @default(now())

  account CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([referenceId])
}

// ─────────────────────────────────────────────────────────
// Stripe
// ─────────────────────────────────────────────────────────

// Webhook idempotency guard — a Stripe event id can only be processed once.
model StripeEvent {
  id          String   @id // Stripe event id (evt_...)
  type        String
  payload     String // raw JSON body
  status      String   @default("PROCESSED") // PROCESSED | FAILED | SKIPPED
  error       String?
  processedAt DateTime @default(now())

  @@index([type])
}

model Invoice {
  id              String    @id @default(cuid())
  organizationId  String? // billing owner
  userId          String // attribution
  number          String    @unique // TF-000001
  description     String
  amountMicros    Int
  currency        String    @default("GBP")
  status          String    @default("PAID") // PAID | OPEN | FAILED | REFUNDED
  periodStart     DateTime?
  periodEnd       DateTime?
  stripeInvoiceId String?   @unique
  stripePaymentIntentId String?
  hostedUrl       String?
  createdAt       DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
}

// ─────────────────────────────────────────────────────────
// Dedicated GPU (catalog seeded now; rental lifecycle = Phase 9)
// ─────────────────────────────────────────────────────────

// GPU catalog — EXAMPLE pricing, configurable, not final
model GpuType {
  id                String  @id // rtx-4090 | l4 | l40s | a100-80gb | h100
  displayName       String
  vramGb            Int
  hourlyRateMicros  Int // example pricing, configurable
  description       String
  isActive          Boolean @default(true)
  sortOrder         Int     @default(0)

  instances GpuInstance[]
}

// Rental lifecycle state machine (Phase 9 — tables exist, features gated off)
model GpuInstance {
  id             String    @id @default(cuid())
  userId         String
  gpuTypeId      String
  status         String    @default("PROVISIONING") // PROVISIONING | STARTING | RUNNING | IDLE | STOPPING | STOPPED | FAILED | DELETING | DELETED
  hourlyRateMicros Int
  region         String    @default("uk")
  idleTimeoutMinutes Int   @default(30) // configurable auto-shutdown
  lastRequestAt  DateTime?
  startedAt      DateTime?
  stoppedAt      DateTime?
  currentRunMicros Int     @default(0) // accrued cost of current billing window
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  gpuType     GpuType     @relation(fields: [gpuTypeId], references: [id])
  deployments Deployment[]

  @@index([userId])
  @@index([status])
}

model Deployment {
  id            String   @id @default(cuid())
  gpuInstanceId String
  userId        String
  name          String
  modelRef      String // customer model reference / artifact
  endpointPath  String   @unique // /v1/my-model style managed endpoint
  status        String   @default("CREATING") // CREATING | READY | FAILED | STOPPED
  healthStatus  String   @default("UNKNOWN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  gpuInstance GpuInstance @relation(fields: [gpuInstanceId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
