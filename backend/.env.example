# ============================================================
# TaskFlow Backend — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# --- Runtime ---
# "development" or "production". In production, the app refuses to start
# if any required secret below is missing (see app/config.py).
ENVIRONMENT=development

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000

# Base URLs (used to build OAuth callback URLs and Stripe redirect URLs —
# never derived from request Host headers)
API_BASE_URL=http://localhost:8000
APP_BASE_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+psycopg2://taskflow:taskflow@localhost:5432/taskflow

# --- Sessions / app secrets ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_SECRET=
# Pepper mixed into API key hashing (in addition to per-key salt)
TASKFLOW_API_KEY_PEPPER=
# Shared secret for server-to-server calls from the Next.js backend only
# (must match BACKEND_SERVICE_SECRET in frontend/.env.local). Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
BACKEND_SERVICE_SECRET=

# --- Stripe (get these from https://dashboard.stripe.com) ---
# Test mode keys start with sk_test_ / pk_test_, live mode with sk_live_ / pk_live_
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the Stripe CLI (`stripe listen`) in dev, or Dashboard > Webhooks in prod
STRIPE_WEBHOOK_SECRET=
# Create these Products/Prices in the Stripe Dashboard first
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
STRIPE_PRICE_CREDIT_10=
STRIPE_PRICE_CREDIT_25=
STRIPE_PRICE_CREDIT_50=
STRIPE_PRICE_CREDIT_100=

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft Entra OAuth (https://portal.azure.com — App registrations) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" allows personal + work/school accounts; use a specific tenant ID to restrict
MICROSOFT_TENANT_ID=common

# --- GitHub OAuth (https://github.com/settings/developers) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email delivery (required in production for verification/reset/invite emails) ---
EMAIL_PROVIDER=console
# console = prints to server logs (development only, blocked in production)
# smtp = use SMTP_* settings below
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@taskflow.web-agent.org

# --- External AI providers (optional — enable only what you configure) ---
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
MOONSHOT_API_KEY=
MOONSHOT_API_BASE=https://api.moonshot.ai/v1
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# --- AWS (only needed once GPU hosting phase begins — leave blank for now) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
