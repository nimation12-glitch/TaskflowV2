// TaskFlow — Prisma schema
//
// OWNERSHIP: this schema owns identity only — User, Account (OAuth links),
// Session, VerificationToken — the standard NextAuth.js Prisma adapter
// tables, extended with a password hash for the Credentials provider.
//
// Organizations, billing, credits, API keys, and usage all live in the
// FastAPI backend's own Postgres schema (see backend/app/models). Both
// point at the same Postgres database but are migrated independently
// (Prisma migrate here, Alembic there) — see docs/AGENTS.md for why.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Only set for users who registered with email/password.
  // Users who only use OAuth have no row here at all.
  passwordHash  String?

  // Platform-admin flag. Legacy: superseded by siteRole below, still
  // honoured as a fallback so accounts granted admin before siteRole
  // existed keep their access. Claim-only: there is no API or UI that lets
  // a user set this on themselves or anyone else. It's set directly in the
  // database at issuance time (see scripts/set-platform-admin.ts) and is
  // read server-side (lib/platform-admin.ts) to decide the
  // is_platform_admin claim on the backend JWT and to gate the /admin/* UI.
  // Never exposed to or trusted from the client.
  isPlatformAdmin Boolean @default(false)

  // Site-level role: OWNER is the single platform owner (there must always
  // be exactly one), ADMIN is granted by the owner from the admin panel,
  // and everyone else is USER. OWNER + ADMIN get the admin panel (users,
  // organizations, maintenance) and ban/unban powers; only OWNER can
  // grant or revoke ADMIN. Distinct from organization membership roles —
  // those are per-workspace (backend DB), this is a platform-wide role
  // (identity DB).
  siteRole String @default("USER")

  // Ban state. A non-null bannedAt means the account is banned: sign-in is
  // refused (credentials and OAuth alike) and any existing session is
  // bounced out of the app at the layout. Set by the owner/admins from the
  // admin panel; unbanning clears both fields.
  bannedAt     DateTime?
  bannedReason String?

  // "light" | "dark" | "system". Deliberately stored here rather than in
  // localStorage/a cookie — the app has a hard no-browser-storage-for-
  // preferences constraint, and this doubles as a real account setting that
  // follows the user across devices.
  themePreference String @default("system")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// A password reset request. Short-lived, single-use.
model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}
