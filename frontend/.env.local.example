# ============================================================
# TaskFlow Frontend — Environment Configuration
# Copy to .env.local for development. In Vercel, set these as
# Project > Settings > Environment Variables instead.
# ============================================================

# Same Postgres database as the backend (Prisma migrates the identity
# tables independently of the backend's Alembic migrations — see
# prisma/schema.prisma for why).
DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow

# --- NextAuth ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Backend service-to-service ---
# The FastAPI backend URL and the two shared secrets it also has in its .env.
# AUTH_SECRET here MUST match the backend's AUTH_SECRET exactly (both sign/verify
# the short-lived per-request JWT). BACKEND_SERVICE_SECRET MUST match the
# backend's BACKEND_SERVICE_SECRET exactly (used only for pre-session calls
# like organization bootstrap).
BACKEND_URL=http://localhost:8000
BACKEND_SERVICE_SECRET=

# Public backend URL, safe for the browser (used only for docs examples)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- OAuth providers (leave blank to disable a provider's login button) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email ---
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@taskflow.web-agent.org
